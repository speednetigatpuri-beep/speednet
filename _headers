# Cloudflare: keep the temporary *.workers.dev / *.pages.dev copies out of Google,
# so only https://speednetonline.in gets indexed.
https://speednet.:account.workers.dev/*
  X-Robots-Tag: noindex
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Cache images and logos for a week
/img/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
